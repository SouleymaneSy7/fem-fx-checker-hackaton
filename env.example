# FX Checker — Environment Variables
# Copy this file to .env.local and fill in values

# Frankfurter API (no key required — backed by ECB)
# https://frankfurter.dev/
NEXT_PUBLIC_EXCHANGE_API_BASE=<your_exchange_api_url>

# Rate refresh interval in milliseconds (default: 60000 = 1 minute)
NEXT_PUBLIC_RATE_REFRESH_INTERVAL=<your_rate_refresh_interval_value>
